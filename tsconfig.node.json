{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "composite": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["electron/**/*", "src/types/**/*", "src/utils/domains.ts", "src/utils/flight.ts", "electron.vite.config.ts"]
}
